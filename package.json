{
  "name": "@0xdoublesharp/sloth-vdf",
  "version": "0.0.3",
  "description": "Sloth sequential delay evaluation and verification for TypeScript and Solidity",
  "repository": "https://github.com/doublesharp/sloth-vdf",
  "scripts": {
    "build": "node scripts/tasks.mjs build",
    "compile": "node scripts/tasks.mjs compile",
    "typegen": "node scripts/tasks.mjs typegen",
    "typecheck": "node scripts/tasks.mjs typecheck",
    "test": "node scripts/tasks.mjs test",
    "test:typescript": "node scripts/tasks.mjs typescript",
    "test:solidity": "node scripts/tasks.mjs solidity",
    "test:fuzz": "node scripts/tasks.mjs fuzz",
    "test:invariant": "node scripts/tasks.mjs invariant",
    "coverage": "node scripts/tasks.mjs coverage",
    "benchmark": "node scripts/tasks.mjs benchmark",
    "pack": "node scripts/tasks.mjs pack"
  },
  "keywords": [
    "solidity",
    "vdf",
    "verifiable delay function",
    "sloth",
    "sloth vdf",
    "randomness",
    "random",
    "crypto",
    "web3",
    "EVM"
  ],
  "author": "@0xDoubleSharp",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@0xdoublesharp/abi-typegen": "0.8.0",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "forge-std": "https://codeload.github.com/foundry-rs/forge-std/tar.gz/refs/tags/v1.16.2",
    "typescript": "5.9.3",
    "viem": "2.57.10",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "contracts",
    "CHANGELOG.md",
    "sloth.svg"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./contracts/*": "./contracts/*"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  }
}
